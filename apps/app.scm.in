;; SNOS application memory description. @BANK@ is substituted with the app's
;; ROM bank (e.g. c8) by tools/buildapp.sh.
;;
;; An app is linked for ONE specific bank. That is not a limitation to work
;; around — it is the design (PLAN.md §1). Cart ROM is already executable, so
;; binding an app to a bank at link time is what removes the need for a loader
;; and a relocator entirely.
;;
;; RAM comes in two very different flavours here:
;;   - stack and direct page MUST be in bank $00, because the 65816 puts them
;;     there and nowhere else. The kernel hands the app the slots reserved in
;;     the kernel's own linker.scm, and both files have to agree.
;;   - everything else lives in WRAM bank $7F, the app arena. Every app is
;;     linked to the SAME arena addresses, which is safe precisely because only
;;     one app runs at a time.

(define memories
  '((memory DirectPage
            (address (#x1900 . #x19ff))   ; app DP slot, per kernel linker.scm
            (type RAM)
            (section registers ztiny tiny))

    (memory Stack
            (address (#x0c00 . #x18ff))   ; app stack slot, 3328 bytes
            (type RAM)
            (section stack))

    (memory AppNear
            (address (#x7f0000 . #x7f00ff))
            (type RAM)
            (qualifier near)
            (section data znear near fastregs))

    (memory AppFar
            (address (#x7f0100 . #x7fffff))
            (type RAM)
            (qualifier far)
            (section heap zfar far huge))

    (memory AppROM
            (address (#x@BANK@0000 . #x@BANK@ffff))
            (type ROM)
            (qualifier far)
            (section (appheader #x@BANK@0000)
                     code compactcode farcode cdata cnear cfar chuge switch
                     itiny idata inear ifar ihuge data_init_table))

    (block stack (size #xd00))
    (base-address _DirectPageStart DirectPage 0)
    (base-address _NearBaseAddress AppNear 0)
    ))
